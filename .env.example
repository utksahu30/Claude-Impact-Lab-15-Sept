# Google Gemini / AI Studio credentials (Primary)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PROVIDER=gemini

# Qwen 3.8 Max / DashScope credentials (Alternative / Backup)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_FALLBACK_API_KEY=your_fallback_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# Operational Settings
ALLOW_EXTERNAL_AI=True
CONFIDENCE_REVIEW_THRESHOLD=0.6
DUPLICATE_SIMILARITY_THRESHOLD=0.82
ALLOW_RAW_TEXT_RETENTION=False
MAX_UPLOAD_MB=10
MAX_ROWS_PER_BATCH=2000

# Demo auth token (if left blank, a random one is generated and logged at startup)
DEMO_TOKEN=
