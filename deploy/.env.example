# ==============================================================================
# CivicTrace Bhopal (PS-5) - Production Environment Configuration
# ==============================================================================

# AI Inference Engine (Qwen 3.8 Max via Alibaba DashScope)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_FALLBACK_API_KEY=your_fallback_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# Operational Modes (Set to false to run completely offline on deterministic rules)
ALLOW_EXTERNAL_AI=true

# Database Configuration (Defaults to local SQLite WAL mode)
# In containerized deployments, ensure the path points to a persistent volume
DATABASE_URL=sqlite:///bhopal_triage.db

# Operator Authorization Token (Leave blank to generate randomly at startup)
DEMO_TOKEN=bhopal-admin-secret-key-2026

# Triaging & Deduplication Thresholds
CONFIDENCE_REVIEW_THRESHOLD=0.6
DUPLICATE_SIMILARITY_THRESHOLD=0.82
AI_TIMEOUT_SECONDS=45.0
MAX_UPLOAD_SIZE_BYTES=10485760
